# EmailJS keys for the contact form (see README.md for setup).
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Base URL of the mustang-ball-server backend (see server/README.md).
# Defaults to http://localhost:4000 if unset.
VITE_API_URL=http://localhost:4000

# OAuth client ID used to sign into /admin (see server/README.md "Setting
# up GitHub sign-in"). Must match the backend's GITHUB_CLIENT_ID. Not
# secret (only the backend's GITHUB_CLIENT_SECRET is), but sign-in won't
# work without it.
VITE_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
