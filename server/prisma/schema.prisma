generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  editor
}

enum OAuthProvider {
  github
}

model User {
  id        Int            @id @default(autoincrement())
  email     String         @unique
  name      String
  role      Role           @default(editor)
  isActive  Boolean        @default(true)
  // Set on first successful sign-in; null for an allow-listed email that
  // hasn't signed in yet. Login has no password — the email itself is the
  // allow-list entry, verified against GitHub.
  provider  OAuthProvider?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  revisions ContentRevision[]

  @@map("users")
}

model ContentBlock {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@map("content_blocks")
}

model ContentRevision {
  id        Int      @id @default(autoincrement())
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedBy Int?
  user      User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([key, createdAt])
  @@map("content_revisions")
}
