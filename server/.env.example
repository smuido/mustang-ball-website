# Postgres connection string. On Render this is provided automatically
# when you link a Render Postgres database to this service.
DATABASE_URL=postgresql://user:password@localhost:5432/mustang_ball

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# 400 days is the longest a session token's cookie-equivalent lifetime is
# worth setting — browsers cap actual cookies there, and there's no reason
# for a bearer token to outlive that. Effectively "don't expire": sessions
# only end on explicit sign-out.
JWT_EXPIRES_IN=400d

# Comma-separated list of origins allowed to call this API. Include your
# local dev server and the deployed frontend's origin.
ALLOWED_ORIGINS=http://localhost:5173,https://<your-github-username>.github.io

# GitHub OAuth App credentials — see server/README.md "Setting up GitHub
# sign-in" for how to create these. The client ID is not secret, but the
# secret genuinely is — never expose it to the frontend.
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

PORT=4000
NODE_ENV=development

# Used by `npm run db:seed` to allow-list your first login (no password —
# they sign in with GitHub themselves). Safe to leave set permanently;
# re-running the seed just re-confirms this email is an admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
