# Postgres connection string. On Render this is provided automatically
# when you link a Render Postgres database to this service.
DATABASE_URL=postgresql://user:password@localhost:5432/mustang_ball

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# 400 days is the longest a cookie can actually live in any browser
# (Chrome/Firefox both cap Max-Age there), so this is effectively "don't
# expire" in practice — sessions only end on explicit sign-out or a
# password change, not from a timer.
JWT_EXPIRES_IN=400d

# Comma-separated list of origins allowed to call this API with credentials.
# Include your local dev server and the deployed frontend's origin.
ALLOWED_ORIGINS=http://localhost:5173,https://<your-github-username>.github.io

PORT=4000
NODE_ENV=development

# Only used by `npm run db:seed` to create the first admin login. Leave
# unset after the first deploy — the seed script skips creating a user if
# one with this email already exists, but there's no reason to keep the
# password sitting in an env var once you have a real admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Admin
